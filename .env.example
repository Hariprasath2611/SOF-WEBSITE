# ==============================================================================
# SFD 2026 EVENT REGISTRATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# Admin Dashboard Password (protects admin analytics, status toggles, and exports)
ADMIN_PASSWORD=sfd2026admin

# ------------------------------------------------------------------------------
# GOOGLE CLOUD SERVICE ACCOUNT CREDENTIALS
# Create a Service Account in Google Cloud Console with Google Sheets API enabled.
# Generate and download a JSON key, then copy the email and private key below:
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# If in a single line, keep \n escaped newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# GOOGLE SPREADSHEETS IDs
# Extract the ID from the URL of each Google Sheet:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
#
# IMPORTANT: Share each spreadsheet with the GOOGLE_SERVICE_ACCOUNT_EMAIL as 'Editor'.
# ------------------------------------------------------------------------------

# 1. Master Spreadsheet ("Event Registration Master" with Dashboard, All_Registrations, Event_Settings)
GOOGLE_SHEETS_MASTER_ID=your_master_spreadsheet_id_here

# 2. Demo Stall Spreadsheet ("Demo_Stall_Registrations")
DEMO_STALL_SHEET_ID=your_demo_stall_sheet_id_here

# 3. Mini Hackathon Spreadsheet ("Mini_Hackathon_Registrations")
MINI_HACKATHON_SHEET_ID=your_mini_hackathon_sheet_id_here

# 4. Poster Design Spreadsheet ("Poster_Design_Registrations")
POSTER_DESIGN_SHEET_ID=your_poster_design_sheet_id_here

# 5. Panel of Discussion Spreadsheet ("Panel_of_Discussion_Registrations")
PANEL_DISCUSSION_SHEET_ID=your_panel_discussion_sheet_id_here

# 6. Workshop Spreadsheet ("Workshop_Registrations")
WORKSHOP_SHEET_ID=your_workshop_sheet_id_here
